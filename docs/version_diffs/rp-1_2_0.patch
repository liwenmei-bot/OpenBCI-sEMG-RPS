+class GuidedActivityGate:
+    """Current rest plus two explicitly cued amplitude references; never fits or labels the SVM.
+
+    Quality-valid rest windows may survive an isolated interruption. A channel that
+    varies at rest is not by itself a reason to veto every other channel. Each
+    reference must demonstrate separation from rest before its channels are used.
+    """
+    mode = "guided"
+
+    def __init__(self, fs, width, hop, seconds=8., reference_seconds=3.):
+        require(fs > 0 and width > 0 and hop > 0 and seconds >= 2 and reference_seconds >= 2,
+                "参考测量参数无效。")
+        self.fs, self.width, self.hop = float(fs), int(width), int(hop)
+        self.seconds, self.reference_seconds = float(seconds), float(reference_seconds)
+        self.on_z, self.off_z, self.minimum_channels = .5, .15, 1
+        self.revision, self.change_token, self.history = 0, 0, []
+        self.profile, self.references, self.error = None, {}, ""
+        self.last_reference_id, self.last_score, self.last_ratios = None, None, None
+        self.begin("startup", 0)
+
+    def _start(self, phase, row, reason):
+        if getattr(self, "state", "").startswith("collecting") and getattr(self, "samples", []):
+            self.history.append({"revision": self.revision, "status": "aborted", "phase": self.state,
+                                 "reason": reason, "valid_windows": len(self.samples)})
+        self.revision += 1
+        self.state, self.reason, self.request_row = phase, reason, int(row)
+        self.samples, self.rows, self.invalid_windows, self.partial_resets = [], [], 0, 0
+        self.prediction_samples, self.latest_prediction = [], -1
+        self.first_row, self.last_row, self.error = None, None, ""
+        self.last_reference_id, self.last_score, self.last_ratios = None, None, None
+        self.change_token += 1
+
+    def begin(self, reason, row):
+        self.profile, self.references = None, {}
+        self.reference_id = None
+        self._start("collecting_rest", row, reason)
+
+    def begin_action(self, class_id, row):
+        require(class_id in (0, 1) and self.profile is not None, "请先完成静息参考，再采集动作参考。")
+        require(not self.state.startswith("collecting"), "当前参考尚在采集中。")
+        self.references.pop(class_id, None)
+        self.reference_id = int(class_id)
+        self._start("collecting_action", row, "user_cued_action_reference")
+
+    def reset_partial(self):
+        # Keep already valid rest windows across isolated bad windows, rather than
+        # silently starting the entire eight seconds over after every interruption.
+        if self.state.startswith("collecting"):
+            self.partial_resets += 1
+
+    def elapsed(self):
+        if not self.samples: return 0.
+        return min(self.required_seconds(), (self.width+(len(self.samples)-1)*self.hop)/self.fs)
+
+    def required_seconds(self):
+        return self.seconds if self.state == "collecting_rest" else self.reference_seconds
+
+    def _finish_rest(self):
+        x = np.asarray(self.samples)
+        median = np.median(x, axis=0)
+        mad = np.median(np.abs(x-median), axis=0)
+        scale = np.maximum.reduce([1.4826*mad, .10*median, np.full(4, .01)])
+        upper = np.maximum(np.quantile(x, .95, axis=0), median+3*scale)
+        half = len(x)//2
+        a, b = np.median(x[:half], axis=0), np.median(x[half:], axis=0)
+        drift = np.maximum(a, b)/np.maximum(np.minimum(a, b), 1e-6)
+        warning = np.flatnonzero(drift > 1.5)
+        self.profile = {"median_rms_uv": median.tolist(), "mad_rms_uv": mad.tolist(),
+            "robust_scale_uv": scale.tolist(), "rest_upper_rms_uv": upper.tolist(),
+            "variable_rest_channels_one_based": (warning+1).tolist(),
+            "valid_windows": len(x), "invalid_windows": self.invalid_windows,
+            "partial_interruptions": self.partial_resets, "half_median_ratio": drift.tolist()}
+        self.history.append({"revision": self.revision, "phase": "rest", "status": "accepted", **self.profile})
+        self.state, self.samples, self.rows = "need_actions", [], []
+        self.change_token += 1
+
+    def _finish_action(self):
+        x = np.asarray(self.samples)
+        # Holding before pressing is permitted. Discard the first 0.5 seconds
+        # so that a cue-to-contraction transition is not fitted when present.
+        keep = np.asarray(self.rows) >= self.rows[0]+int(round(.5*self.fs))
+        stable = x[keep]
+        require(len(stable) >= 8, "动作参考有效窗口不足。")
+        q25, median = np.quantile(stable, .25, axis=0), np.median(stable, axis=0)
+        rest = np.asarray(self.profile["median_rms_uv"])
+        upper = np.asarray(self.profile["rest_upper_rms_uv"])
+        scale = np.asarray(self.profile["robust_scale_uv"])
+        delta = q25-upper
+        good = (delta > np.maximum(.10*rest, .01)) & (median > 1.15*upper)
+        candidates = np.flatnonzero(good)
+        channels = sorted(candidates, key=lambda k: delta[k]/scale[k], reverse=True)[:2]
+        predictions = np.asarray(self.prediction_samples)[keep]
+        available = predictions >= 0
+        match = float(np.mean(predictions[available] == self.reference_id)) if available.any() else None
+        attempt = {"revision": self.revision, "phase": "action", "cue_class_id": self.reference_id,
+            "status": "accepted" if channels else "rejected", "valid_windows": len(stable),
+            "action_q25_rms_uv": q25.tolist(), "action_median_rms_uv": median.tolist(),
+            "excess_above_rest_uv": delta.tolist(), "selected_channels_one_based": [int(k)+1 for k in channels],
+            "frozen_svm_reference_match_not_independent_accuracy": match,
+            "frozen_svm_candidate_counts": {str(k):int(np.sum(predictions == k)) for k in [0,1]}}
+        self.history.append(attempt)
+        if channels:
+            self.references[self.reference_id] = dict(attempt, channels=[int(k) for k in channels])
+            self.error = ""
+        else:
+            self.error = "该动作参考未明显高于静息：请保持自然用力重测，或查看四通道RMS与逐窗候选。"
+        self.state = "ready" if set(self.references) == {0, 1} else "need_actions"
+        self.samples, self.rows = [], []
+        self.change_token += 1
+
+    def observe(self, rms, row, usable):
+        rms = np.asarray(rms, dtype=float)
+        valid = bool(usable and rms.shape == (4,) and np.isfinite(rms).all() and (rms >= 0).all())
+        if self.state.startswith("collecting"):
+            self.first_row = int(row) if self.first_row is None else self.first_row
+            self.last_row = int(row)
+            required = self.required_seconds()
+            span = (self.last_row-self.first_row+self.width)/self.fs
+            if span > max(2*required, required+5.) and self.elapsed() < required:
+                self.state = "failed"
+                self.error = "有效数据不足，参考测量已暂停；查看QC原因、时间戳和输入单位，再重新测静息。"
+                self.change_token += 1
+                return None, None
+            if not valid:
+                self.invalid_windows += 1
+                return None, None
+            self.samples.append(rms.copy()); self.rows.append(int(row)); self.prediction_samples.append(self.latest_prediction)
+            if self.elapsed()+1e-9 >= required:
+                if self.state == "collecting_rest": self._finish_rest()
+                else: self._finish_action()
+        if self.state != "ready" or not valid: return None, None
+        upper = np.asarray(self.profile["rest_upper_rms_uv"])
+        best, best_id, best_z = -1., None, None
+        for label, reference in self.references.items():
+            channels = reference["channels"]
+            delta = np.asarray(reference["excess_above_rest_uv"])
+            ratios = np.zeros(4)
+            ratios[channels] = np.maximum(0., (rms[channels]-upper[channels])/delta[channels])
+            score = float(np.min(ratios[channels]))
+            if score > best: best, best_id, best_z = score, label, ratios
+        self.last_reference_id, self.last_score, self.last_ratios = best_id, best, best_z
+        self.minimum_channels = len(self.references[best_id]["channels"])
+        return best, best_z
+
+    def snapshot(self):
+        if self.state == "collecting_rest": instruction = "自然放松，正在测量当前静息"
+        elif self.state == "collecting_action": instruction = "请现在保持%s，正在采集动作幅值参考" % ("石头" if self.reference_id == 0 else "布")
+        elif self.state == "need_actions":
+            missing = ["石头" if k == 0 else "布" for k in (0, 1) if k not in self.references]
+            instruction = "静息已记录；请依次点击“测%s”并保持对应动作" % "、测".join(missing)
+        elif self.state == "ready": instruction = "活动参考已设置；先放松，确认释放后再做动作"
+        else: instruction = self.error
+        return {"mode": self.mode, "state": self.state, "revision": self.revision,
+            "elapsed_seconds": self.elapsed(), "required_seconds": self.required_seconds(),
+            "instruction": instruction, "error": self.error,
+            "rest_ready": self.profile is not None, "reference_id": self.reference_id,
+            "reference_channels": {str(k): v["selected_channels_one_based"] for k, v in self.references.items()},
+            "reference_classifier_match": {str(k):v["frozen_svm_reference_match_not_independent_accuracy"] for k,v in self.references.items()},
+            "matched_reference_id": self.last_reference_id, "minimum_active_channels": self.minimum_channels,
+            "on_threshold": self.on_z, "off_threshold": self.off_z,
+            "invalid_windows": self.invalid_windows, "partial_interruptions": self.partial_resets}
+
+    def report(self):
+        return {"schema": "openbci_rp_binary_guided_activity_v1", "status": self.snapshot(),
+            "rest_profile": self.profile, "action_references": self.references, "history": self.history,
+            "reference_labels_used_for": "activity_gate_only_not_classifier_or_evaluation_truth",
+            "classifier_updated": False, "references_updated_during_recognition": False,
+            "settings_require_new_independent_real_time_validation": True}
