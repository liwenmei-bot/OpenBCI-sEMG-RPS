+class ButtonGestureDetector(GestureDetector):
+    """Button time fixes a capture interval; the button supplies no class label."""
+    def __init__(self, params):
+        self.request_id, self.requests, self.processing_clock, self.sample_clock = 0, [], None, None
+        super().__init__(params)
+
+    def reset_state(self):
+        super().reset_state()
+        self.pending, self.requested_clock, self.capture_end, self.deadline = False, None, None, None
+        self.not_before_row, self.status, self.invalid_windows = None, "manual_idle", 0
+
+    def finish_request(self, status, reason="", event_id=None):
+        if self.requests and self.requests[-1]["status"] == "pending":
+            completed = self.processing_clock
+            if completed is not None and completed < self.requests[-1]["requested_lsl_time_s"]: completed = None
+            self.requests[-1].update(status=status, reason=reason, completed_lsl_time_s=completed,
+                event_id=event_id, valid_windows=len(self.history), invalid_windows=self.invalid_windows)
+        self.pending = False
+
+    def close(self, row, reason):
+        super().close(row, reason)
+        if getattr(self, "pending", False): self.finish_request("interrupted", reason)
+
+    def request(self, requested_clock, row, segment_id):
+        require(np.isfinite(requested_clock), "按钮时间无效。")
+        require(not self.pending, "本次动作采集尚未结束。")
+        self.close(row, "next_button_request")
+        self.reset_state(); self.segment_id = segment_id
+        self.request_id += 1
+        self.pending, self.requested_clock = True, float(requested_clock)
+        self.processing_clock = self.requested_clock
+        self.capture_end = self.requested_clock+float(self.params["manual_capture_seconds"])
+        self.deadline = self.capture_end+float(self.params["manual_grace_seconds"])
+        self.not_before_row, self.onset_candidate_row = int(row), int(row)
+        self.status = "manual_settling"
+        self.requests.append({"request_id":self.request_id, "requested_lsl_time_s":self.requested_clock,
+            "capture_end_lsl_time_s":self.capture_end, "accepted_row":int(row), "status":"pending",
+            "requested_class":None, "completed_lsl_time_s":None, "event_id":None, "reason":""})
+
+    def exclude_preclick_samples(self, stamps, origin):
+        if not self.pending: return
+        previous = np.flatnonzero(~np.isfinite(stamps) | (stamps < self.requested_clock))
+        if len(previous):
+            updated = max(self.not_before_row, int(origin+previous[-1]+1))
+            if updated != self.not_before_row: self.not_before_row = updated; self.clear_votes()
+
+    def check_timeout(self, now):
+        self.processing_clock = float(now)
+        if self.pending and now >= self.deadline:
+            self.finish_request("timeout", "capture_end_not_reached_with_timely_data")
+            self.clear_votes(); self.status = "manual_timeout"
+            return True
+        return False
+
+    def decide(self, row, activity):
+        if len(self.history) < self.params["manual_minimum_valid_windows"]:
+            self.finish_request("insufficient_valid_windows", "not_enough_quality_valid_post_transition_windows")
+            self.status = "manual_quality_failed"
+            return self.status, None
+        labels = np.asarray([value[0] for value in self.history])
+        votes = np.bincount(labels, minlength=2)
+        means = np.mean([value[1] for value in self.history], axis=0)
+        tied = np.flatnonzero(votes==votes.max())
+        winner = int(tied[np.argmax(means[tied])])
+        event = {"event_id":len(self.events)+1, "decision_row":int(row),
+            "onset_candidate_row":self.onset_candidate_row, "class_id":winner,
+            "vote_agreement":float(votes[winner]/len(labels)), "activity_score":float(activity),
+            "release_row":None, "release_reason":"manual_result_until_next_click_or_stop",
+            "trigger_mode":"manual", "manual_request_id":self.request_id,
+            "manual_requested_lsl_time_s":self.requested_clock,
+            "manual_response_seconds":self.processing_clock-self.requested_clock,
+            "manual_first_allowed_start_row":self.not_before_row+int(self.params["settle_samples"]),
+            "manual_capture_seconds":self.params["manual_capture_seconds"], "manual_valid_windows":len(labels)}
+        self.events.append(event); self.active_event = event; self.emitted = True
+        self.finish_request("recognized", event_id=event["event_id"])
+        self.status = "manual_result"
+        return self.status, event
+
+    def step(self, row, segment_id, usable, activity, predicted, decision_scores):
+        if self.segment_id != segment_id:
+            was_pending = self.pending
+            self.close(row, "continuity_segment_change"); self.reset_state(); self.segment_id = segment_id
+            if was_pending:
+                self.status = "manual_interrupted"
+                return self.status, None
+        if self.pending and self.processing_clock is not None and self.check_timeout(self.processing_clock):
+            return self.status, None
+        if not self.pending:
+            if not usable:
+                return "manual_quality_failed", None
+            return ("manual_result" if self.active_event is not None else self.status), None
+        require(self.sample_clock is not None and self.processing_clock is not None, "按钮模式缺少窗口时间戳。")
+        first_end = self.not_before_row+int(self.params["settle_samples"])+int(self.params["window_samples"])-1
+        if row < first_end:
+            self.status = "manual_settling"
+            return self.status, None
+        # End-of-window time must fit inside the fixed capture interval. A later
+        # window only confirms the watermark, and never contributes to the vote.
+        if self.sample_clock <= self.capture_end:
+            if usable and predicted >= 0 and np.isfinite(decision_scores).all():
+                self.append_vote(row, predicted, decision_scores)
+            else: self.invalid_windows += 1
+        if self.processing_clock >= self.capture_end and self.sample_clock >= self.capture_end:
+            return self.decide(row, activity)
+        self.status = "manual_collecting_votes"
+        return self.status, None
+
+    def snapshot(self):
+        remaining = None if not self.pending or self.processing_clock is None else max(0.,self.capture_end-self.processing_clock)
+        return {"manual_pending":self.pending, "manual_request_id":self.request_id,
+            "manual_seconds_remaining":remaining, "manual_request_count":len(self.requests),
+            "manual_timeout_count":sum(request["status"]=="timeout" for request in self.requests),
+            "manual_capture_seconds":self.params["manual_capture_seconds"],
+            "manual_minimum_valid_windows":self.params["manual_minimum_valid_windows"]}
+
